VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
VITE_CLERK_JWT_TEMPLATE_NAME=industrin-session
APP_URL=https://www.industrin.net
COMPANY_PORTAL_URL=https://www.industrin.net/company/login
# HS256 signing key of the Clerk JWT template "industrin-session" (Clerk Dashboard > JWT templates > custom signing key)
CLERK_JWT_SECRET=your_template_signing_key
# Optional: expected `iss` claim of the template tokens (your Clerk Frontend API URL)
CLERK_JWT_ISSUER=
# Production Netlify origin(s) allowed to call /api/claims/*; comma-separated, e.g. https://www.industrin.net
FRONTEND_ORIGIN=https://your-site.netlify.app
